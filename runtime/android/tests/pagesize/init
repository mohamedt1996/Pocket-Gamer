#!/bin/busybox sh
# PID 1 of the 16 KB page VM: load the modules, mount the runner's own root (9p,
# read-only) with tmpfs where the test writes, and run the test inside it.
/bin/busybox --install -s /bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
for m in $(cat /modules.order); do insmod "/modules/$m" 2>/dev/null; done
echo "vm: kernel $(uname -r), page size $(getconf PAGESIZE 2>/dev/null || echo ?)"
mkdir -p /newroot
# The runner's root, read-only; writable places get tmpfs (no overlayfs: over 9p it broke
# /proc/self/fd links, which Android 15's realpath() relies on).
mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576,ro,cache=loose hostroot /newroot || { echo "vm: 9p root failed"; poweroff -f; }
for d in /data/data/org.pocketarcade.madeira /var/lib/sudo /var/tmp; do mount -t tmpfs -o size=6g tmpfs "/newroot$d" 2>/dev/null; done
mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576 vmout /newroot/vmout || echo "vm: output share failed"
mount -t proc proc /newroot/proc; mount -t sysfs sys /newroot/sys
mount -t devtmpfs dev /newroot/dev; mkdir -p /newroot/dev/pts; mount -t devpts devpts /newroot/dev/pts
mount -t tmpfs tmpfs /newroot/tmp; mount -t tmpfs tmpfs /newroot/run
chroot /newroot /bin/bash /vmout/inner.sh
echo $? > /newroot/vmout/rc
sync; poweroff -f
