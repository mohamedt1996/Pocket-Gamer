From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pocket Arcade contributors <noreply@pocketarcade.invalid>
Date: Wed, 21 Oct 2026 22:00:00 +0000
Subject: [PATCH] ntdll: Name the caller of a branch to a null address (ARM64EC)

---
diff --git a/dlls/ntdll/signal_arm64ec.c b/dlls/ntdll/signal_arm64ec.c
index 2a1333f..bf196ab 100644
--- a/dlls/ntdll/signal_arm64ec.c
+++ b/dlls/ntdll/signal_arm64ec.c
@@ -3555,10 +3555,120 @@ static void dispatch_syscall( ARM64_NT_CONTEXT *context )
 }
 
 
+/* Module+offset of an address, for android_report_wild_branch. */
+static void android_describe( const char *what, ULONG64 addr )
+{
+    LDR_DATA_TABLE_ENTRY *mod;
+    if (addr >= 0x10000 && !LdrFindEntryForAddress( (void *)(ULONG_PTR)addr, &mod ))
+        ERR( "  %s=%p %s+0x%lx\n", what, (void *)(ULONG_PTR)addr, debugstr_w(mod->BaseDllName.Buffer),
+             (unsigned long)(addr - (ULONG_PTR)mod->DllBase) );
+    else
+        ERR( "  %s=%p\n", what, (void *)(ULONG_PTR)addr );
+}
+
+static void arm64x_check_call_early(void);
+static void arm64x_check_icall_early(void);
+
+/* If lr follows a BL, decode the stub it called: every adrp+ldr pair names a
+ * pointer slot (IAT, auxiliary IAT, dispatcher) and the value it holds now. */
+static void android_dump_call_site( ULONG64 lr )
+{
+    const UINT32 *insn = (const UINT32 *)(ULONG_PTR)(lr - 4), *stub;
+    ULONG64 page[32] = { 0 };
+    MEMORY_BASIC_INFORMATION info;
+    char name[32];
+    int i, rd, rn;
+
+    if (lr < 0x10000 || NtQueryVirtualMemory( GetCurrentProcess(), insn, MemoryBasicInformation, &info,
+                                              sizeof(info), NULL ) || info.State != MEM_COMMIT) return;
+    {
+        LDR_DATA_TABLE_ENTRY *mod;
+        const IMAGE_ARM64EC_METADATA *md;
+        if (!LdrFindEntryForAddress( (void *)(ULONG_PTR)lr, &mod ) &&
+            (md = arm64ec_get_module_metadata( mod->DllBase )))
+        {
+            char *b = mod->DllBase;
+            ERR( "  caller's dispatch slots: call=%p icall=%p call_no_redirect=%p fptr=%p ret=%p"
+                 " (check_call=%p early=%p/%p)\n",
+                 *(void **)(b + md->__os_arm64x_dispatch_call), *(void **)(b + md->__os_arm64x_dispatch_icall),
+                 *(void **)(b + md->__os_arm64x_dispatch_call_no_redirect),
+                 *(void **)(b + md->__os_arm64x_dispatch_fptr), *(void **)(b + md->__os_arm64x_dispatch_ret),
+                 arm64x_check_call, arm64x_check_call_early, arm64x_check_icall_early );
+        }
+    }
+    if ((*insn & 0xfc000000) != 0x94000000) return;  /* not a BL */
+    stub = insn + (((INT32)(*insn << 6)) >> 6);
+    android_describe( "called", (ULONG_PTR)stub );
+    for (i = 0; i < 8; i++)
+    {
+        UINT32 op = stub[i];
+        if ((op & 0x9f000000) == 0x90000000)  /* adrp */
+        {
+            INT64 imm = ((INT64)(((op >> 5) & 0x7ffff) << 2 | ((op >> 29) & 3)) << 43) >> 31;
+            page[op & 31] = (((ULONG_PTR)&stub[i]) & ~(ULONG64)0xfff) + imm;
+        }
+        else if ((op & 0xffc00000) == 0xf9400000)  /* ldr Xt, [Xn, #imm] */
+        {
+            rd = op & 31; rn = (op >> 5) & 31;
+            if (!page[rn]) continue;
+            {
+                const ULONG64 *slot = (const ULONG64 *)(ULONG_PTR)(page[rn] + ((op >> 10) & 0xfff) * 8);
+                sprintf( name, "x%d <- [%p] ec=%d", rd, slot, *slot >= 0x10000 ? RtlIsEcCode( *slot ) : -1 );
+                android_describe( name, *slot );
+            }
+            page[rd] = 0;
+        }
+    }
+}
+
+static void android_report_wild_branch( const ARM64_NT_CONTEXT *ctx )
+{
+    const ULONG64 *fp = (const ULONG64 *)(ULONG_PTR)ctx->Fp;
+    char name[16];
+    int i;
+
+    android_describe( "wild branch to", ctx->Pc );
+    ERR( "  thread %04lx, in simulation %u\n", GetCurrentThreadId(), get_arm64ec_cpu_area()->InSimulation );
+    ERR( "  dispatch_call_no_redirect=%p dispatch_fptr=%p dispatch_ret=%p BeginSimulation=%p\n",
+         __os_arm64x_dispatch_call_no_redirect, __os_arm64x_dispatch_fptr, __os_arm64x_dispatch_ret,
+         pBeginSimulation );
+    android_describe( "lr", ctx->Lr );
+    android_dump_call_site( ctx->Lr );
+    android_describe( "x16", ctx->X16 );
+    android_describe( "x17", ctx->X17 );
+    android_describe( "x9", ctx->X9 );
+    android_describe( "x10", ctx->X10 );
+    android_describe( "x11", ctx->X11 );
+    ERR( "  x0=%p x1=%p x2=%p x3=%p sp=%p fp=%p\n", (void *)(ULONG_PTR)ctx->X0, (void *)(ULONG_PTR)ctx->X1,
+         (void *)(ULONG_PTR)ctx->X2, (void *)(ULONG_PTR)ctx->X3, (void *)(ULONG_PTR)ctx->Sp, fp );
+    for (i = 0; i < 16 && fp && !((ULONG_PTR)fp & 7); i++)
+    {
+        MEMORY_BASIC_INFORMATION info;
+        if (NtQueryVirtualMemory( GetCurrentProcess(), fp, MemoryBasicInformation, &info, sizeof(info), NULL )
+            || info.State != MEM_COMMIT || (char *)fp + 16 > (char *)info.BaseAddress + info.RegionSize)
+            break;
+        sprintf( name, "#%d", i );
+        android_describe( name, fp[1] );
+        if ((ULONG_PTR)fp[0] <= (ULONG_PTR)fp) break;
+        fp = (const ULONG64 *)(ULONG_PTR)fp[0];
+    }
+}
+
 static void * __attribute__((used)) prepare_exception_arm64ec( EXCEPTION_RECORD *rec, ARM64EC_NT_CONTEXT *context, ARM64_NT_CONTEXT *arm_ctx )
 {
     if (rec->ExceptionCode == STATUS_EMULATION_SYSCALL) dispatch_syscall( arm_ctx );
     context_arm_to_x64( context, arm_ctx );
+    /* Android: a branch to a null address or to memory that is not code (a
+     * null or stale function pointer: the fault address is the pc itself) is
+     * always a bug and the exception record alone cannot say who made it. Name
+     * the caller: lr, the frame-pointer chain and the registers that carry call
+     * targets, each resolved to module+offset. */
+    if (rec->ExceptionCode == STATUS_ACCESS_VIOLATION &&
+        (arm_ctx->Pc < 0x10000 || (rec->NumberParameters >= 2 && rec->ExceptionInformation[1] == arm_ctx->Pc)))
+    {
+        static LONG wild_reported;
+        if (InterlockedIncrement( &wild_reported ) <= 4) android_report_wild_branch( arm_ctx );
+    }
     /* iOS-Madeira task#34 probe: FEX's LogMan output is invisible on iOS (its
      * write(2) resolves to the PE CRT's WriteFile → unplumbed std handle),
      * so trace the guest-exception conversion from the wine side. Rate-
