From 1e03c7ee63693e85733992fd4859b84373ea7e6a Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Tue, 20 Oct 2026 12:38:06 +0000
Subject: [PATCH] dnsapi: Use the Android system resolver on Android

---
 dlls/dnsapi/libresolv.c | 160 +++++++++++++++++++++++++++++++++++++++-
 dlls/dnsapi/record.c    |   2 +-
 2 files changed, 159 insertions(+), 3 deletions(-)

diff --git a/dlls/dnsapi/libresolv.c b/dlls/dnsapi/libresolv.c
index 62b823c..fe76810 100644
--- a/dlls/dnsapi/libresolv.c
+++ b/dlls/dnsapi/libresolv.c
@@ -24,7 +24,7 @@
 
 #include "config.h"
 
-#ifdef HAVE_RESOLV
+#if defined(HAVE_RESOLV) || defined(__ANDROID__)
 #include <stdarg.h>
 #include <string.h>
 #include <stdio.h>
@@ -43,6 +43,14 @@
 #ifdef HAVE_NETDB_H
 # include <netdb.h>
 #endif
+#ifdef __ANDROID__
+# include <dlfcn.h>
+# include <errno.h>
+# include <poll.h>
+# include <arpa/inet.h>
+# include <arpa/nameser.h>
+# include <pthread.h>
+#endif
 
 #include "ntstatus.h"
 #include "windef.h"
@@ -58,6 +66,152 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dnsapi);
 
+#ifdef __ANDROID__
+
+/* Android has no public res_query() or _res state. Queries go through the
+ * system resolver with android_res_nquery() (libandroid, API 29+), looked up
+ * at run time so the module still loads on older releases. */
+
+typedef UINT64 android_net_handle_t;
+#define ANDROID_NETWORK_UNSPECIFIED ((android_net_handle_t)0)
+#define ANDROID_RESOLV_NO_CACHE_STORE  (1 << 1)
+#define ANDROID_RESOLV_NO_CACHE_LOOKUP (1 << 2)
+#define ANDROID_QUERY_TIMEOUT_MS 10000
+
+static int (*p_android_res_nquery)( android_net_handle_t, const char *, int, int, UINT );
+static int (*p_android_res_nresult)( int, int *, unsigned char *, size_t );
+static void (*p_android_res_cancel)( int );
+static pthread_once_t android_resolver_once = PTHREAD_ONCE_INIT;
+
+static void load_android_resolver( void )
+{
+    void *lib = dlopen( "libandroid.so", RTLD_NOW | RTLD_LOCAL );
+
+    if (!lib)
+    {
+        WARN( "libandroid.so not available: %s\n", dlerror() );
+        return;
+    }
+    p_android_res_nquery = dlsym( lib, "android_res_nquery" );
+    p_android_res_nresult = dlsym( lib, "android_res_nresult" );
+    p_android_res_cancel = dlsym( lib, "android_res_cancel" );
+    if (!p_android_res_nquery || !p_android_res_nresult || !p_android_res_cancel)
+    {
+        WARN( "Android DNS resolver API not available (needs Android 10)\n" );
+        p_android_res_nquery = NULL;
+    }
+}
+
+static DNS_STATUS map_rcode( int rcode )
+{
+    switch (rcode)
+    {
+    case ns_r_formerr:  return DNS_ERROR_RCODE_FORMAT_ERROR;
+    case ns_r_servfail: return DNS_ERROR_RCODE_SERVER_FAILURE;
+    case ns_r_nxdomain: return DNS_ERROR_RCODE_NAME_ERROR;
+    case ns_r_notimpl:  return DNS_ERROR_RCODE_NOT_IMPLEMENTED;
+    case ns_r_refused:  return DNS_ERROR_RCODE_REFUSED;
+    default:            return DNS_ERROR_RCODE;
+    }
+}
+
+static NTSTATUS resolv_get_searchlist( void *args )
+{
+    const struct get_searchlist_params *params = args;
+
+    /* Android does not expose a DNS search list to apps. */
+    if (!params->list || *params->len < sizeof(WCHAR))
+    {
+        *params->len = sizeof(WCHAR);
+        return !params->list ? ERROR_SUCCESS : ERROR_MORE_DATA;
+    }
+    params->list[0] = 0;
+    *params->len = sizeof(WCHAR);
+    return ERROR_SUCCESS;
+}
+
+static NTSTATUS resolv_get_serverlist( void *args )
+{
+    const struct get_serverlist_params *params = args;
+    DNS_ADDR_ARRAY *addrs = params->addrs;
+    const char *server = getenv( "WINE_ANDROID_DNS_SERVER" );
+    DWORD needed = FIELD_OFFSET(DNS_ADDR_ARRAY, AddrArray[1]);
+    SOCKADDR_IN *sa;
+    struct in_addr addr;
+
+    /* Android does not expose its DNS servers to native code. Report one
+     * IPv4 server so callers that insist on a list keep working; actual
+     * queries always use the system resolver. */
+    if (!server || !*server) server = "8.8.4.4";
+    if (inet_pton( AF_INET, server, &addr ) != 1) return DNS_ERROR_NO_DNS_SERVERS;
+    if (params->family == WS_AF_INET6) return DNS_ERROR_NO_DNS_SERVERS;
+
+    if (!addrs || *params->len < needed)
+    {
+        *params->len = needed;
+        return !addrs ? ERROR_SUCCESS : ERROR_MORE_DATA;
+    }
+    *params->len = needed;
+    memset( addrs, 0, needed );
+    addrs->AddrCount = addrs->MaxCount = 1;
+    sa = (SOCKADDR_IN *)addrs->AddrArray[0].MaxSa;
+    sa->sin_family = WS_AF_INET;
+    sa->sin_addr.WS_s_addr = addr.s_addr;
+    addrs->AddrArray[0].Data.DnsAddrUserDword[0] = sizeof(*sa);
+    return ERROR_SUCCESS;
+}
+
+static NTSTATUS resolv_set_serverlist( void *args )
+{
+    const IP4_ARRAY *addrs = args;
+
+    if (addrs && addrs->AddrCount)
+        FIXME( "custom DNS servers are not supported on Android, using the system resolver\n" );
+    return ERROR_SUCCESS;
+}
+
+static NTSTATUS resolv_query( void *args )
+{
+    const struct query_params *params = args;
+    unsigned char *answer = params->buf;
+    UINT flags = 0;
+    struct pollfd pfd;
+    int fd, len, rcode = 0, ret;
+
+    pthread_once( &android_resolver_once, load_android_resolver );
+    if (!p_android_res_nquery) return DNS_ERROR_RCODE_SERVER_FAILURE;
+
+    if (params->options & DNS_QUERY_BYPASS_CACHE)
+        flags |= ANDROID_RESOLV_NO_CACHE_STORE | ANDROID_RESOLV_NO_CACHE_LOOKUP;
+
+    if ((fd = p_android_res_nquery( ANDROID_NETWORK_UNSPECIFIED, params->name, ns_c_in,
+                                    params->type, flags )) < 0)
+    {
+        WARN( "android_res_nquery(%s) failed: %d\n", debugstr_a(params->name), fd );
+        return DNS_ERROR_RCODE_SERVER_FAILURE;
+    }
+
+    pfd.fd = fd;
+    pfd.events = POLLIN;
+    do ret = poll( &pfd, 1, ANDROID_QUERY_TIMEOUT_MS ); while (ret < 0 && errno == EINTR);
+    if (ret <= 0)
+    {
+        p_android_res_cancel( fd );  /* also closes fd */
+        return ERROR_TIMEOUT;
+    }
+
+    /* android_res_nresult() closes fd */
+    if ((len = p_android_res_nresult( fd, &rcode, answer, *params->len )) < 0)
+        return DNS_ERROR_RCODE_SERVER_FAILURE;
+    if (rcode != ns_r_noerror) return map_rcode( rcode );
+    /* like res_query(): a NOERROR reply without answers is NO_DATA */
+    if (len < 12 || !(answer[6] | answer[7])) return DNS_ERROR_RCODE_NAME_ERROR;
+    *params->len = len;
+    return ERROR_SUCCESS;
+}
+
+#else  /* __ANDROID__ */
+
 /* call res_init() just once because of a bug in Mac OS X 10.4 */
 /* call once per thread on systems that have per-thread _res */
 static void init_resolver( void )
@@ -340,6 +494,8 @@ static NTSTATUS resolv_query( void *args )
     return ret;
 }
 
+#endif  /* __ANDROID__ */
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     resolv_get_searchlist,
@@ -459,4 +615,4 @@ C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
 
 #endif  /* _WIN64 */
 
-#endif /* HAVE_RESOLV */
+#endif /* HAVE_RESOLV || __ANDROID__ */
diff --git a/dlls/dnsapi/record.c b/dlls/dnsapi/record.c
index 1b4cbfe..29b6533 100644
--- a/dlls/dnsapi/record.c
+++ b/dlls/dnsapi/record.c
@@ -1144,7 +1144,7 @@ static DNS_STATUS extract_message_records( const DNS_MESSAGE_BUFFER *buffer, WOR
     const BYTE *ptr = (const BYTE *)buffer->MessageBody;
     unsigned int num;
 
-    if (hdr->IsResponse && !hdr->AnswerCount) return DNS_ERROR_BAD_PACKET;
+    if (hdr->IsResponse && !hdr->AnswerCount) ret = DNS_INFO_NO_RECORDS;
 
     for (num = 0; num < hdr->QuestionCount; num++)
         if (!(ptr = skip_record( ptr, end, DnsSectionQuestion ))) return DNS_ERROR_BAD_PACKET;
