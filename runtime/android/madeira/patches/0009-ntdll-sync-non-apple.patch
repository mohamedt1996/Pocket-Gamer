From d7fe17c7ba973253c525cadb8e6a1ed704cd3965 Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Tue, 20 Oct 2026 13:17:36 +0000
Subject: [PATCH] ntdll: Build Madeira's sync instrumentation on non-Apple
 hosts

The eco QoS switch, the fault-safe waiter read and the alert-latency clock used Apple APIs outside any Apple guard, so ntdll did not compile for Linux or Android. Eco becomes a no-op there; the reads use process_vm_readv() and the clock uses CLOCK_MONOTONIC.
---
 dlls/ntdll/unix/sync.c | 32 ++++++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 380e724..5c1d585 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -36,6 +36,9 @@
 #include <signal.h>
 #include <sys/types.h>
 #include <sys/ioctl.h>
+#ifndef __APPLE__
+#include <sys/uio.h>
+#endif
 #include <sys/mman.h>
 #ifdef HAVE_SYS_SYSCALL_H
 #include <sys/syscall.h>
@@ -2179,6 +2182,7 @@ volatile long long ios_xp_yield, ios_xp_yield_slept, ios_xp_delay, ios_xp_delay_
  * eco = 1. QoS can only be set by a thread on itself, so each thread applies
  * a change the next time it waits, sleeps or yields, which every guest thread
  * does many times a second. */
+#ifdef __APPLE__
 volatile int ios_eco_gen = 1;          /* bumped on every toggle; 1 so a thread's first poll applies */
 static volatile int ios_eco_on = -1;   /* -1 = madeira.cfg not read yet */
 static qos_class_t ios_eco_class = QOS_CLASS_UTILITY;
@@ -2219,6 +2223,13 @@ void madeira_set_eco( int on )   /* the app's ECO pill */
              : ios_eco_class == QOS_CLASS_USER_INITIATED ? "user-initiated" : "utility" );
 }
 int madeira_get_eco(void) { ios_eco_init(); return ios_eco_on > 0; }
+#else
+/* QoS classes are Apple-only; elsewhere eco is a no-op. */
+void ios_eco_apply_self(void) { }
+#define IOS_ECO_POLL() do { } while (0)
+void madeira_set_eco( int on ) { (void)on; }
+int madeira_get_eco(void) { return 0; }
+#endif
 
 NTSTATUS WINAPI NtSetEvent( HANDLE handle, LONG *prev_state )
 {
@@ -4971,12 +4982,20 @@ int ios_alert_waiter_lookup( unsigned int tid, const void **addr, int *age_s, in
 static int ios_alert_waiter_read( void *out, const void *addr, size_t size )
 {
     unsigned char data[64];
+#ifdef __APPLE__
     mach_vm_size_t got = 0;
 
     if (!size || size > sizeof(data)) return 0;
     if (mach_vm_read_overwrite( mach_task_self(), (mach_vm_address_t)(ULONG_PTR)addr,
                                size, (mach_vm_address_t)(ULONG_PTR)data, &got ) != KERN_SUCCESS ||
         got != size) return 0;
+#else
+    /* process_vm_readv() copies without faulting on bad addresses, like Mach. */
+    struct iovec local = { data, size }, remote = { (void *)addr, size };
+
+    if (!size || size > sizeof(data)) return 0;
+    if (process_vm_readv( getpid(), &local, 1, &remote, 1, 0 ) != (ssize_t)size) return 0;
+#endif
     memcpy( out, data, size );
     return 1;
 }
@@ -5186,7 +5205,20 @@ void ios_orphan_check( const unsigned long long *live_stamps, int nstamps )
  * WaitOnAddress); read by the thread sampler's periodic line. */
 volatile long long ios_alert_wakes, ios_alert_waits, ios_alert_wait_timeouts;
 /* ml1122: alert -> waiter-running latency, and the alert-spin-us experiment. */
+#ifdef __APPLE__
 #include <mach/mach_time.h>
+#else
+/* Monotonic nanoseconds standing in for the Mach clock used by the
+ * alert-latency instrumentation below. */
+typedef struct { unsigned int numer, denom; } mach_timebase_info_data_t;
+static inline int mach_timebase_info( mach_timebase_info_data_t *tb ) { tb->numer = tb->denom = 1; return 0; }
+static inline unsigned long long mach_absolute_time(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (unsigned long long)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+#endif
 volatile long long ios_alert_lat_n, ios_alert_lat_ticks, ios_alert_lat_hist[6], ios_alert_spin_tries, ios_alert_spin_hits;
 static volatile unsigned long long ios_alert_stamp[4096];
 static inline unsigned ios_alert_slot( const void *entry ) { return (unsigned)(((ULONG_PTR)entry >> 2) & 4095); }
