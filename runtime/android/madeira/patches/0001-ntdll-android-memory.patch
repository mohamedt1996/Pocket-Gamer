From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pocket Arcade contributors <noreply@pocketarcade.invalid>
Date: Tue, 20 Oct 2026 12:36:48 +0000
Subject: [PATCH] ntdll: Android userfaultfd and W^X-safe image loading

The address space limits stay Wine's: virtual_init measures the host's
(39-bit on most 4 KB-page kernels, 47-bit on 16 KB-page ones), while a fixed
39-bit user limit on a larger host sent every unhinted allocation into an
endless "reserve what is above the limit and retry" loop.
---
diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 781598f..54ddd57 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -76,7 +76,8 @@
 #if defined(HAVE_LINUX_USERFAULTFD_H) && defined(HAVE_LINUX_FS_H)
 # include <linux/userfaultfd.h>
 # include <linux/fs.h>
-#if defined(UFFD_FEATURE_WP_ASYNC) && defined(PM_SCAN_WP_MATCHING)
+/* Android's app seccomp policy kills the process on userfaultfd(). */
+#if defined(UFFD_FEATURE_WP_ASYNC) && defined(PM_SCAN_WP_MATCHING) && !defined(__ANDROID__)
 #define USE_UFFD_WRITEWATCH
 #endif
 #endif
@@ -3426,7 +3427,15 @@ static NTSTATUS virtual_map_image( HANDLE mapping, void **addr_ptr, SIZE_T *size
     status = map_image_view( &view, image_info, size, limit_low, limit_high, alloc_type );
     if (status) goto done;
 
+#ifdef __ANDROID__
+    /* Android forbids making a file-backed mapping executable once it has been
+     * written (relocations) and app storage may be mounted noexec. Treat the
+     * image like removable media so private pages are read into anonymous
+     * memory; shared sections are still mmapped. */
+    status = map_image_into_view( view, nt_name, unix_fd, image_info, machine, shared_fd, TRUE );
+#else
     status = map_image_into_view( view, nt_name, unix_fd, image_info, machine, shared_fd, needs_close );
+#endif
     if (status == STATUS_SUCCESS)
     {
         if (offset)
