From 60d5ecf66822c57e9612c8520583edda88157192 Mon Sep 17 00:00:00 2001
From: port <p@p>
Date: Tue, 20 Oct 2026 12:36:48 +0000
Subject: [PATCH] ntdll: Android address space, userfaultfd and W^X-safe image
 loading

---
 dlls/ntdll/unix/virtual.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
index 781598f..2bbbe83 100644
--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -76,7 +76,8 @@
 #if defined(HAVE_LINUX_USERFAULTFD_H) && defined(HAVE_LINUX_FS_H)
 # include <linux/userfaultfd.h>
 # include <linux/fs.h>
-#if defined(UFFD_FEATURE_WP_ASYNC) && defined(PM_SCAN_WP_MATCHING)
+/* Android's app seccomp policy kills the process on userfaultfd(). */
+#if defined(UFFD_FEATURE_WP_ASYNC) && defined(PM_SCAN_WP_MATCHING) && !defined(__ANDROID__)
 #define USE_UFFD_WRITEWATCH
 #endif
 #endif
@@ -186,7 +187,12 @@ static void *address_space_start = (void *)0x110000; /* keep DOS area clear */
 #else
 static void *address_space_start = (void *)0x10000;
 #endif
-#ifdef _WIN64
+#if defined(_WIN64) && defined(__ANDROID__)
+/* Android arm64 kernels commonly give apps a 39-bit address space. */
+static void *address_space_limit = (void *)0x7fffff0000;  /* top of the total available address space */
+static void *user_space_limit    = (void *)0x7fffff0000;  /* top of the user address space */
+static void *working_set_limit   = (void *)0x7fffff0000;  /* top of the current working set */
+#elif defined(_WIN64)
 static void *address_space_limit = (void *)0x7fffffff0000;  /* top of the total available address space */
 static void *user_space_limit    = (void *)0x7fffffff0000;  /* top of the user address space */
 static void *working_set_limit   = (void *)0x7fffffff0000;  /* top of the current working set */
@@ -3426,7 +3432,15 @@ static NTSTATUS virtual_map_image( HANDLE mapping, void **addr_ptr, SIZE_T *size
     status = map_image_view( &view, image_info, size, limit_low, limit_high, alloc_type );
     if (status) goto done;
 
+#ifdef __ANDROID__
+    /* Android forbids making a file-backed mapping executable once it has been
+     * written (relocations) and app storage may be mounted noexec. Treat the
+     * image like removable media so private pages are read into anonymous
+     * memory; shared sections are still mmapped. */
+    status = map_image_into_view( view, nt_name, unix_fd, image_info, machine, shared_fd, TRUE );
+#else
     status = map_image_into_view( view, nt_name, unix_fd, image_info, machine, shared_fd, needs_close );
+#endif
     if (status == STATUS_SUCCESS)
     {
         if (offset)
