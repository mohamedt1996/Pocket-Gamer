   cmp x16, x17
+#ifdef FEX_ANDROID_HOST
+  // Android: Madeira's loader already binds FEX's ntdll imports to the native
+  // implementations, which are not redirection sources: their LUT entry is 0
+  // and the lookup would return ntdll's base. Keep any target that has no
+  // entry, and never read the entry one past the end of the table.
+  b.hs end
+  adrp x17, NtDllRedirectionLUT
+  ldr x17, [x17, #:lo12:NtDllRedirectionLUT]
+  ldr w17, [x17, x16, lsl #2]
+  cbz w17, end
+  add x11, x17, x9
+#else
   b.hi end
   adrp x17, NtDllRedirectionLUT
   ldr x17, [x17, #:lo12:NtDllRedirectionLUT]
   ldr w11, [x17, x16, lsl #2]
   add x11, x11, x9
+#endif
 end:
   ret
 
